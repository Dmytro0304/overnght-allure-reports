# Copy to .env in this directory. Never commit .env.

# ─── Target environment ───────────────────────────────────────────────────────
BASE_URL=https://stg.overnght.com
# API_BASE_URL=https://api.stg.overnght.com

# ─── Auth tokens (staging JWTs) ───────────────────────────────────────────────
ADMIN_TOKEN=
REGULAR_TOKEN=

# ─── UI sign-in (TC-AUTH-001 …) ─────────────────────────────────────────────
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ─── Video Player (TC-PLAYER-*) — optional IDs ────────────────────────────────
PREMIUM_EVENT_ID=
GEO_BLOCKED_EVENT_ID=
LIVE_EVENT_ID=
VOD_EVENT_ID=
FREE_EVENT_ID=

# ─── Event Highlights (TC-EVENT-HL-*) ────────────────────────────────────────
HIGHLIGHTS_EVENT_ID=
HIGHLIGHTS_SEARCH_TERM=

# ─── Subscription & wallet user ───────────────────────────────────────────────
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# E2E_COUPON_USER_EMAIL=
# E2E_COUPON_USER_PASSWORD=
# E2E_USER2_EMAIL=
# E2E_USER2_PASSWORD=
# E2E_DECLINE_USER_EMAIL=
# E2E_DECLINE_USER_PASSWORD=
# E2E_NONAME_USER_EMAIL=
# E2E_NONAME_USER_PASSWORD=
# E2E_DUP_USER_EMAIL=
# E2E_DUP_USER_PASSWORD=

# ─── Telegram (npm run report:notify / staging:full) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Allure на GitHub Pages + Slack (npm run report:allure:publish / report:slack)
# Репозиторий отчётов: https://github.com/Dmytro0304/overnght-allure-reports.git
# После включения Pages: https://dmytro0304.github.io/overnght-allure-reports/
ALLURE_REPORT_PUBLIC_URL=
ALLURE_REPORTS_GIT_TOKEN=
# ALLURE_REPORTS_GIT_URL=https://github.com/Dmytro0304/overnght-allure-reports.git
# ALLURE_PUBLISH_BRANCH=main
SLACK_WEBHOOK_URL=

# ─── Optional ─────────────────────────────────────────────────────────────────
